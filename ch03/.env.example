PORT=3000

# ------------------------------------------------------------------------------
# パターン1: Keycloak（ローカル）で動かす場合
# ------------------------------------------------------------------------------
OIDC_ISSUER_URL=http://localhost:8080/realms/oauth-book
OIDC_CLIENT_ID=oauth-book-app
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# ------------------------------------------------------------------------------
# パターン2: Google ログインで動かす場合
# （Google Cloud Console で発行した認証情報を設定）
# ------------------------------------------------------------------------------
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
